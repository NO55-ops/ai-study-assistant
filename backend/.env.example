# Backend configuration. Copy to backend/.env and fill in locally.
# Never commit real values; set these in Render for production.
APP_ENV=production
SUPABASE_URL=
SUPABASE_KEY=
JWT_SECRET=
# Exact frontend origin(s), comma separated, no trailing slash. Required for credentialed CORS.
CORS_ORIGINS=https://your-frontend.vercel.app
# Set to 1 so session cookies are Secure + SameSite=None for the cross-site Vercel -> Render setup.
COOKIE_SECURE=1
# Used to build password-reset links; must point at the deployed frontend.
FRONTEND_URL=https://your-frontend.vercel.app
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OLLAMA_MODEL=
RESEND_API_KEY=
PASSWORD_RESET_FROM=
SEND_PASSWORD_RESET_EMAIL=
PASSWORD_RESET_TOKEN_TTL_MINUTES=
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=
ADMIN_EMAIL=
ADMIN_PASSWORD=
STORAGE_DIR=
MAX_UPLOAD_BYTES=
ALLOW_LOCAL_LIBRARY_FALLBACK=
